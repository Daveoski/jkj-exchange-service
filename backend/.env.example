# Copy to backend/.env for local development. In production set these in Vercel.

# Database. Leave unset locally to use SQLite (./jkj_dev.db).
# In production Neon (via the Vercel integration) injects DATABASE_URL and DATABASE_URL_UNPOOLED.
# Any Postgres URL works, e.g. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# Admin sign-in. JWT_SECRET must be a long random string in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# The first administrator is created from these on first sign-in (only if no admins exist).
# Change the password from the dashboard afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Strong-Passw0rd!
ADMIN_SESSION_HOURS=12

# Public website origin(s), comma separated. Used for CORS and dashboard links in emails.
FRONTEND_URL=http://localhost:3000
# Shared with the website so it can forward the visitor IP for rate limiting.
PROXY_SECRET=

# Resend (https://resend.com). Without a verified domain Resend only delivers to the
# account owner's address; verify a domain and set NOTIFICATION_FROM_EMAIL to use it.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=JKJ Exchange Services <onboarding@resend.dev>
NOTIFICATION_TO_EMAIL=jideofork@gmail.com
REPLY_TO_EMAIL=jideofork@gmail.com
SEND_CUSTOMER_CONFIRMATION=true

# Cloudflare Turnstile (optional but recommended).
TURNSTILE_SECRET_KEY=
REQUIRE_TURNSTILE=false

# Rate limits.
INQUIRIES_PER_IP_PER_HOUR=6
INQUIRIES_PER_EMAIL_PER_DAY=5
LOGIN_ATTEMPTS_PER_15M=8
