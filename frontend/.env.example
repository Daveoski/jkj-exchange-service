# Copy to .env.local for local development; set matching variables in Vercel for production.

# Public origin of this website (used for SEO metadata, sitemap and canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only: where the FastAPI backend runs. Browser calls to /api/* are proxied here.
BACKEND_URL=http://localhost:8000

# Server-side only: must match PROXY_SECRET in the backend so visitor IPs are forwarded safely.
PROXY_SECRET=

# Optional: Cloudflare Turnstile public site key (pair with TURNSTILE_SECRET_KEY on the backend).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
